--!strict
-- indexfile: the text of a generated registry index (plan section 6). Pure, so it is unit-tested; `gen-index` does
-- the file work.
--
-- An index is the `init.luau` of a registry folder, such as `Config/Buildables`. It requires every other file in the
-- folder and returns them by file name, so the same registry works in Roblox and in Lune tests.
--
-- State owned: none.
--
-- Usage:
--     indexfile.render({ "CoalDropper.luau", "init.luau" })

local SUFFIX = ".luau"
local INDEX = "init.luau"

local indexfile = {}

--[[
	The entry names in a folder listing: every `.luau` file except the index itself, without the suffix, sorted.
	@param fileNames the names in the folder
	@return entry names
	@error when a name is not a valid Luau identifier, since it becomes a table key and an ID
]]
function indexfile.entries(fileNames: { string }): { string }
	local names = {}
	for _, fileName in fileNames do
		if fileName ~= INDEX and string.sub(fileName, -#SUFFIX) == SUFFIX then
			local name = string.sub(fileName, 1, -#SUFFIX - 1)
			if string.match(name, "^[%a_][%w_]*$") == nil then
				error(`{fileName}: a registry file name must be letters and digits only, like CoalDropper.luau`, 0)
			end
			table.insert(names, name)
		end
	end
	table.sort(names)
	return names
end

--[[
	The full text of the index for these entries.
	@param entries entry names, already sorted
	@return the file contents, formatted the way StyLua formats them
]]
function indexfile.render(entries: { string }): string
	local lines = {
		"--!strict",
		"-- Generated by `lune run gen-index` from the files in this folder. Do not edit it by hand: add or remove a file",
		"-- here and run `lune run gen-index` (the check does it too).",
		"",
	}
	if #entries == 0 then
		table.insert(lines, "local index: { [string]: any } = {}")
	else
		table.insert(lines, "local index: { [string]: any } = {")
		for _, name in entries do
			table.insert(lines, `\t{name} = require("@self/{name}"),`)
		end
		table.insert(lines, "}")
	end
	table.insert(lines, "")
	table.insert(lines, "return index")
	table.insert(lines, "")
	return table.concat(lines, "\n")
end

return indexfile
